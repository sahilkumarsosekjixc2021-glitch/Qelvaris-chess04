# ===== Browser (public by design; safe to expose) =====
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Leave these two empty until PayPal is ready: the Pro card stays hidden.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_ID=
VITE_PRO_PRICE_LABEL=               # shown on the card, must match the PayPal plan, e.g. $4.99 / month

# ===== Server only (Vercel -> Settings -> Environment Variables). NEVER prefix with VITE_ =====
PAYPAL_ENV=sandbox                 # sandbox while testing, live only on launch day
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                 # from PayPal Developer -> your app -> Webhooks
PAYPAL_PLAN_ID_PRO=                # same plan id as VITE_PAYPAL_PLAN_ID
PAYPAL_PERIOD_DAYS=31              # 31 for a monthly plan, 366 for a yearly plan
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # Supabase -> Settings -> API -> service_role. Full access: keep secret.
SITE_URL=https://your-domain.com   # no trailing slash
