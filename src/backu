
import { useEffect, useRef, useState } from "react";
import { Chess } from "chess.js";
import "./GameReview.css";

const STORAGE_KEY = "qelvarisSavedGames";
const ENGINE_URL = "/stockfish/stockfish-19-lite-single.js";

const PIECES = {
  w: { k: "♔", q: "♕", r: "♖", b: "♗", n: "♘", p: "♙" },
  b: { k: "♚", q: "♛", r: "♜", b: "♝", n: "♞", p: "♟" },
};

function GameReview() {
  const [savedGames, setSavedGames] = useState([]);
  const [pgnText, setPgnText] = useState("");
  const [reviewPgn, setReviewPgn] = useState("");
  const [reviewGame, setReviewGame] = useState(() => new Chess());
  const [moveIndex, setMoveIndex] = useState(0);
  const [flipped, setFlipped] = useState(false);
  const [engineReady, setEngineReady] = useState(false);
  const [thinking, setThinking] = useState(false);
  const [engineResult, setEngineResult] = useState("");
  const [engineError, setEngineError] = useState("");
  const [message, setMessage] = useState("");
  const workerRef = useRef(null);
  const requestRef = useRef(0);

  function refreshSavedGames() {
    try {
      const items = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
      setSavedGames(Array.isArray(items) ? items : []);
    } catch {
      setSavedGames([]);
      setMessage("Saved games read nahi ho sakin.");
    }
  }

  useEffect(() => {
    refreshSavedGames();

    let worker;
    try {
      worker = new Worker(ENGINE_URL);
      workerRef.current = worker;

      worker.onmessage = (event) => {
        const text = String(event.data).trim();

        if (text === "uciok") {
          worker.postMessage("isready");
          return;
        }

        if (text === "readyok") {
          setEngineReady(true);
          return;
        }

        if (text.startsWith("info ") && requestRef.current > 0) {
          const cp = text.match(/\bscore cp (-?\d+)/);
          const mate = text.match(/\bscore mate (-?\d+)/);
          const depth = text.match(/\bdepth (\d+)/);
          const pv = text.match(/\bpv (.+)$/);

          if (cp || mate) {
            const score = cp
              ? (Number(cp[1]) / 100).toFixed(2)
              : `Mate in ${Math.abs(Number(mate[1]))}`;

            setEngineResult(
              `${score}${depth ? ` · Depth ${depth[1]}` : ""}${
                pv ? ` · Line: ${pv[1].split(" ").slice(0, 5).join(" ")}` : ""
              }`
            );
          }
        }

        if (text.startsWith("bestmove")) {
          const move = text.split(/\s+/)[1];
          setEngineResult((old) =>
            `${old ? `${old}\n` : ""}Best move: ${
              move && move !== "(none)" ? move : "No legal move"
            }`
          );
          setThinking(false);
        }
      };

      worker.onerror = () => {
        setEngineError("Stockfish load nahi hua. Engine files check karo.");
        setThinking(false);
      };

      worker.postMessage("uci");
    } catch {
      setEngineError("Engine start nahi hua.");
    }

    return () => {
      workerRef.current = null;
      worker?.terminate();
    };
  }, []);

  const history = reviewGame.history({ verbose: true });

  function buildPosition(pgn, ply) {
    const replay = new Chess();
    replay.loadPgn(pgn);
    const moves = replay.history({ verbose: true });

    // Replay only the requested number of half-moves.
    const position = new Chess();
    for (let i = 0; i < Math.min(ply, moves.length); i++) {
      position.move({
        from: moves[i].from,
        to: moves[i].to,
        promotion: moves[i].promotion || "q",
      });
    }

    return { position, moves };
  }

  function loadGame(pgn, label = "Imported game") {
    try {
      const parsed = new Chess();
      parsed.loadPgn(pgn);

      if (parsed.history().length === 0) {
        setMessage("Is PGN mein koi moves nahi mile.");
        return;
      }

      setReviewPgn(parsed.pgn());
      setReviewGame(new Chess());
      setMoveIndex(0);
      setEngineResult("");
      setEngineError("");
      setMessage(`${label} loaded successfully.`);
    } catch {
      setMessage("PGN read nahi ho paya. Format check karke dobara try karo.");
    }
  }

  function goToMove(ply) {
    if (!reviewPgn) return;

    try {
      const { position } = buildPosition(reviewPgn, ply);
      setReviewGame(position);
      setMoveIndex(ply);
      setEngineResult("");
      setThinking(false);
      requestRef.current++;
      workerRef.current?.postMessage("stop");
    } catch {
      setMessage("Position load nahi ho payi.");
    }
  }

  function analysePosition() {
    const worker = workerRef.current;
    if (!worker || !engineReady) {
      setMessage("Stockfish abhi load ho raha hai.");
      return;
    }

    requestRef.current++;
    setEngineResult("");
    setThinking(true);
    setMessage("");

    worker.postMessage("stop");
    worker.postMessage(`position fen ${reviewGame.fen()}`);
    worker.postMessage("go depth 12");
  }

  function importPgn() {
    const text = pgnText.trim();
    if (!text) {
      setMessage("Pehle PGN text paste karo ya file upload karo.");
      return;
    }
    loadGame(text, "PGN game");
  }

  async function readPgnFile(event) {
    const file = event.target.files?.[0];
    if (!file) return;

    try {
      const text = await file.text();
      setPgnText(text);
      loadGame(text, file.name);
    } catch {
      setMessage("File read nahi ho payi.");
    }
    event.target.value = "";
  }

  function deleteSavedGame(id) {
    const next = savedGames.filter((item) => item.id !== id);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
    setSavedGames(next);
    setMessage("Saved game removed.");
  }

  const files = flipped
    ? ["h", "g", "f", "e", "d", "c", "b", "a"]
    : ["a", "b", "c", "d", "e", "f", "g", "h"];

  const ranks = flipped
    ? [1, 2, 3, 4, 5, 6, 7, 8]
    : [8, 7, 6, 5, 4, 3, 2, 1];

  const totalMoves = reviewPgn
    ? (() => {
        try {
          const parsed = new Chess();
          parsed.loadPgn(reviewPgn);
          return parsed.history().length;
        } catch {
          return 0;
        }
      })()
    : 0;

  const currentMove = history[history.length - 1];

  return (
    <div className="review-page">
      <header className="review-heading">
        <div>
          <p className="review-eyebrow">QELVARIS CHESS / GAME TOOLS</p>
          <h1>Game <em>Review</em></h1>
          <p>Revisit your games. Study each position. Find better moves.</p>
        </div>
        <span className={`review-engine ${engineReady ? "ready" : ""}`}>
          <i /> {engineReady ? "Stockfish ready" : "Loading engine"}
        </span>
      </header>

      {message && <div className="review-message">{message}</div>}
      {engineError && <div className="review-message error">{engineError}</div>}

      <div className="review-columns">
        <section className="review-main">
          <div className="review-card">
            <p className="review-section-label">IMPORT A GAME</p>
            <h2>Bring your game</h2>
            <label className="review-upload">
              <span>↑</span>
              <span><strong>Upload PGN file</strong><small>.pgn files supported</small></span>
              <input type="file" accept=".pgn,text/plain" onChange={readPgnFile} />
            </label>
            <label className="review-input-label" htmlFor="pgn-input">
              Or paste PGN text
            </label>
            <textarea
              id="pgn-input"
              value={pgnText}
              onChange={(event) => setPgnText(event.target.value)}
              placeholder={'[Event "Casual Game"]\n\n1. e4 e5 2. Nf3 Nc6 *'}
              rows={5}
            />
            <button className="review-primary" onClick={importPgn}>
              Import PGN →
            </button>
          </div>

          <div className="review-card">
            <div className="review-card-header">
              <div>
                <p className="review-section-label">YOUR COLLECTION</p>
                <h2>Saved games</h2>
              </div>
              <button className="review-quiet" onClick={refreshSavedGames}>↻ Refresh</button>
            </div>

            {savedGames.length === 0 ? (
              <p className="review-empty">
                No saved games yet. Open Play Chess, play some moves and press Save Game.
              </p>
            ) : (
              <div className="saved-game-list">
                {savedGames.map((item) => (
                  <div className="saved-game" key={item.id}>
                    <div className="saved-game-icon">♞</div>
                    <div className="saved-game-info">
                      <strong>{item.source || "Saved chess game"}</strong>
                      <span>{item.moves || 0} half-moves · {item.result || "*"}</span>
                      <small>
                        {item.date ? new Date(item.date).toLocaleString() : "Saved game"}
                      </small>
                    </div>
                    <div className="saved-game-actions">
                      <button onClick={() => loadGame(item.pgn, "Saved game")}>Review</button>
                      <button onClick={() => deleteSavedGame(item.id)} aria-label="Delete saved game">×</button>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>

        <section className="review-board-section">
          <div className="review-card review-board-card">
            <div className="review-card-header">
              <div>
                <p className="review-section-label">MOVE EXPLORER</p>
                <h2>{reviewPgn ? "Review board" : "Ready for a game"}</h2>
              </div>
              <button className="review-quiet" onClick={() => setFlipped((value) => !value)}>
                ⇅ Flip
              </button>
            </div>

            <div className="review-board">
              {ranks.map((rank) =>
                files.map((file) => {
                  const square = `${file}${rank}`;
                  const piece = reviewGame.get(square);
                  const light = (file.charCodeAt(0) - 97 + rank) % 2 === 0;
                  const isLast = currentMove &&
                    (currentMove.from === square || currentMove.to === square);

                  return (
                    <div
                      key={square}
                      className={`review-square ${light ? "review-light" : "review-dark"} ${isLast ? "review-last" : ""}`}
                    >
                      {file === files[0] && <span className="review-rank">{rank}</span>}
                      {rank === ranks[ranks.length - 1] && <span className="review-file">{file}</span>}
                      {piece && (
                        <span className={`review-piece ${piece.color === "w" ? "review-white-piece" : "review-black-piece"}`}>
                          {PIECES[piece.color][piece.type]}
                        </span>
                      )}
                    </div>
                  );
                })
              )}
            </div>

            <div className="review-navigation">
              <button onClick={() => goToMove(0)} disabled={!reviewPgn || moveIndex === 0}>|←</button>
              <button onClick={() => goToMove(Math.max(0, moveIndex - 1))} disabled={!reviewPgn || moveIndex === 0}>←</button>
              <span>{moveIndex} / {totalMoves} half-moves</span>
              <button onClick={() => goToMove(Math.min(totalMoves, moveIndex + 1))} disabled={!reviewPgn || moveIndex >= totalMoves}>→</button>
              <button onClick={() => goToMove(totalMoves)} disabled={!reviewPgn || moveIndex >= totalMoves}>→|</button>
            </div>

            <div className="review-move-list">
              <p className="review-section-label">GAME MOVES</p>
              {!reviewPgn ? (
                <p className="review-empty">Import a PGN or select a saved game to begin.</p>
              ) : history.length === 0 ? (
                <p className="review-empty">Starting position</p>
              ) : (
                <div className="review-moves-grid">
                  {Array.from({ length: Math.ceil(totalMoves / 2) }, (_, index) => (
                    <div className="review-move-row" key={index}>
                      <span>{index + 1}.</span>
                      <button
                        className={moveIndex === index * 2 + 1 ? "current" : ""}
                        onClick={() => goToMove(index * 2 + 1)}
                      >
                        {(() => {
                          try {
                            return buildPosition(reviewPgn, index * 2 + 1).moves[index * 2]?.san;
                          } catch { return ""; }
                        })()}
                      </button>
                      {index * 2 + 1 < totalMoves && (
                        <button
                          className={moveIndex === index * 2 + 2 ? "current" : ""}
                          onClick={() => goToMove(index * 2 + 2)}
                        >
                          {(() => {
                            try {
                              return buildPosition(reviewPgn, index * 2 + 2).moves[index * 2 + 1]?.san;
                            } catch { return ""; }
                          })()}
                        </button>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div className="review-card review-engine-card">
            <p className="review-section-label">STOCKFISH ANALYSIS</p>
            <h2>Position insights</h2>
            <p className="review-analysis-output">
              {engineResult || "Choose a position and run analysis to get an engine evaluation."}
            </p>
            <button
              className="review-primary"
              onClick={analysePosition}
              disabled={!reviewPgn || !engineReady || thinking}
            >
              {thinking ? "Analysing position..." : "♙ Analyse this position"}
            </button>
            <small className="review-disclaimer">
              Engine scores are estimates from the current side-to-move perspective.
              They are not win probabilities or a complete move-quality report.
            </small>
          </div>
        </section>
      </div>
    </div>
  );
}

export default GameReview;
